# Modèle de api/.env, chargé par le service NSSM.
# Localhost n'est pas autorisé. Le développement local n'utilise pas ce fichier :
# sans SIGRH_ENV_FILE, Django reste en debug et n'accepte que 127.0.0.1 et localhost.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=sk-partners.consulting
SIGRH_SPA_ORIGINS=https://sk-partners.consulting
DJANGO_SECRET_KEY=change-me
# HTTPS (HSTS, cookies sécurisés). Actif par défaut en production ; le mode hors ligne l'exige pour fonctionner.
SIGRH_HTTPS=true

# Antivirus ClamAV : chaque fichier reçu est analysé avant d'être conservé. Actif par défaut en production (service
# Windows ClamAV-Daemon, 127.0.0.1:3310) ; inactif en développement. Démon injoignable : l'envoi est refusé.
# SIGRH_CLAMAV=true
# SIGRH_CLAMAV_HOTE=127.0.0.1
# SIGRH_CLAMAV_PORT=3310

# Temps réel en production multi-processus (laisser vide : un seul processus).
CHANNEL_LAYERS_REDIS_URL=

# Compte administrateur. La connexion reste fermée tant que le matricule et le mot de passe sont vides.
# Après le premier démarrage, ces valeurs se modifient dans Paramètres, pas dans ce fichier.
SIGRH_ADMIN_MATRICULE=
SIGRH_ADMIN_MOT_DE_PASSE=
SIGRH_ADMIN_NOM=
SIGRH_ADMIN_PRENOMS=
SIGRH_ADMIN_FONCTION=Administrateur
SIGRH_ADMIN_ORGANISME=dgpe
